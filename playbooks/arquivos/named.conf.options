// Opções gerais: validação DNSSEC, consultas e transferências permitidas.
options{
    directory "/var/cache/bind";
    listen-on { 127.0.0.1; 192.168.56.102; };
    allow-query { 192.168.56.0/24; localhost; };
    allow-transfer { 192.168.56.0/24; localhost; };
    recursion yes;
    forwarders { 1.1.1.1; 8.8.8.8; };
};