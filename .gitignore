# Exclui logs e arquivos de repetição de tarefas do Ansible.
*.log
*.retry

# Estado local das VMs e arquivo auxiliar de conexão SSH do Vagrant.
.vagrant/
vagrant-ssh-config

# Arquivos de ambiente e certificados; .env.example continua versionável.
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx


# Padrão existente para o diretório local de chaves dos integrantes.
# O Git não expande ~ neste padrão; ele não exclui o diretório keys/ do projeto.
~/github/Projeto-01-ASA-DevOps-com-Vagrant-Ansible/keys

# Configurações locais das ferramentas de IA.
.agents/
.codex/